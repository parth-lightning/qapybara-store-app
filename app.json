{
  "expo": {
    "name": "Stillform",
    "slug": "stillform",
    "version": "1.0.0",
    "scheme": "stillform",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "dev.qapybara.stillform",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ecefef"
      }
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 180,
          "backgroundColor": "#f6f7f7",
          "dark": {
            "backgroundColor": "#171e1e"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
